@page
@model NOVAAPP.Pages.Documentos.IndexModel
@{
    ViewData["Title"] = "Documentos";
    NumberFormatInfo formato = new CultureInfo("es-CR").NumberFormat;
    formato.CurrencySymbol = "";
    formato.CurrencyGroupSeparator = ",";
    formato.NumberDecimalSeparator = ".";
}
@using System.Globalization;
@using Microsoft.AspNetCore.Http
@using System;
@using System.Collections.Generic;
@using System.IO;
@using System.Linq;
@using System.Security.Claims;
@using System.Threading.Tasks;
@using Microsoft.AspNetCore.Mvc;
@using Microsoft.AspNetCore.Mvc.RazorPages;
@using Microsoft.Extensions.Configuration;
@using Refit;
@inject IHttpContextAccessor httpContextAccessor

@{
    var Roles = ((ClaimsIdentity)User.Identity).Claims.Where(d => d.Type == "Roles").Select(s1 => s1.Value).FirstOrDefault().Split("|");
}
@section scripts{


       <script>
        $(document).ready(function() {

                $('#ModalAgregarCliente').on('shown.bs.modal', function () {
                $('#selectC').select2({
                    dropdownParent: $('#ModalAgregarCliente'),
                    width: '100%'

                });
            });


        });
             function  ActualizarConsecutivos() {
            try { 
         $.ajax({
                        type: 'GET',
                        dataType: 'json',
                        url: '@Url.Page("Index", "ActualizarConsecutivos")',
                        data: { },
                        success: function (result) {
                 $("#divProcesando").modal("hide");
                              
                             if (result == false) {
                                 
                                 Swal.fire({
                                     icon: 'error',
                                     title: 'Oops...',
                                     text: 'Ha ocurrido un error al intentar actualizar consecutivos'

                                 })

                             } else {
                                 Swal.fire({
                                     title: "Ha sido actualizado con éxito",

                                     icon: 'success',
                                     showCancelButton: false,
                                     customClass: {
                                         confirmButton: 'swalBtnColor',

                                     },
                                     confirmButtonText: 'OK'
                                 }).then((result) => {
                                     if (result.isConfirmed) {
                                         location.reload();
                                     }
                                 })
                             }
             },
             beforeSend: function () {
                 $("#divProcesando").modal("show");
             }
                     })

           
        }catch(e)
        {

        }
            
               
       }

             function  EnviarConsecutivos() {
            try { 
         $.ajax({
                        type: 'GET',
                        dataType: 'json',
                        url: '@Url.Page("Index", "EnviarConsecutivos")',
                        data: { },
                        success: function (result) {
                 $("#divProcesando").modal("hide");
                              
                             if (result == false) {
                                 
                                 Swal.fire({
                                     icon: 'error',
                                     title: 'Oops...',
                                     text: 'Ha ocurrido un error al intentar enviar a Hacienda'

                                 })

                             } else {
                                 Swal.fire({
                                     title: "Ha sido enviado con éxito",

                                     icon: 'success',
                                     showCancelButton: false,
                                     customClass: {
                                         confirmButton: 'swalBtnColor',

                                     },
                                     confirmButtonText: 'OK'
                                 }).then((result) => {
                                     if (result.isConfirmed) {
                                         location.reload();
                                     }
                                 })
                             }
             },
             beforeSend: function () {
                 $("#divProcesando").modal("show");
             }
                     })

           
        }catch(e)
        {

        }
            
               
       }
        var ids = 0;
        function onClickModal(id) {
            try {
                ids = id;
                Swal.fire({
                    title: '¿Desea sincronizar a SAP?',
                    showDenyButton: true,
                    showCancelButton: false,
                    confirmButtonText: `Aceptar`,
                    denyButtonText: `Cancelar`,
                    customClass: {
                        confirmButton: 'swalBtnColor',
                        denyButton: 'swalDeny'
                    },
                }).then((result) => {
                    /* Read more about isConfirmed, isDenied below */
                    if (result.isConfirmed) {

                        SincronizarSAP();

                    }
                })
            } catch (e) {
                console.log(e);
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: 'Ha ocurrido un error al intentar imprimir ' + e

                })
            }

        }

        function SincronizarSAP() {
            try {
                $.ajax({
                    type: 'GET',
                    dataType: 'json',
                    url: '@Url.Page("Index", "SincronizarSAP")',
                    data: { id: ids },
                    success: function(result) {
                        $("#divProcesando").modal("hide");
                        console.log(result);
                        if (result.success == false) {

                            Swal.fire({
                                icon: 'error',
                                title: 'Oops...',
                                text: 'Ha ocurrido un error al intentar sincronizar a SAP -> ' + result.error

                            })

                        } else {
                            Swal.fire({
                                title: "Ha sido sincronizado a SAP con éxito",

                                icon: 'success',
                                showCancelButton: false,
                                customClass: {
                                    confirmButton: 'swalBtnColor',

                                },
                                confirmButtonText: 'OK'
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    location.reload();
                                }
                            })
                        }
                    },
                    beforeSend: function() {
                        $("#divProcesando").modal("show");
                    }
                })
            } catch (e) {
                console.log(e);
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: 'Ha ocurrido un error al intentar sincronizar a SAP ' + e

                })
            }
        }
            
var codSucFactura = "";

function AbrirModalAgregarCliente(id, codSuc) {
    try {
        ids = id;
        codSucFactura = codSuc;

        // LIMPIAR OPTIONS
        $("#selectC").empty();

        // FILTRAR CAJAS POR CodSuc
        let cajas = @Html.Raw(Json.Serialize(Model.Cajas));

        let filtradas = cajas.filter(c => c.codSuc == codSucFactura);

        // AGREGAR SOLO LAS FILTRADAS
        filtradas.forEach(c => {
            $("#selectC").append(
                `<option value="${c.id}">${c.nombre}</option>`
            );
        });

        $("#ModalAgregarCliente").modal("show");
    } catch (e) {
        Swal.fire({
            icon: 'error',
            title: 'Oops...',
            text: 'Ha ocurrido un error al intentar recuperar cliente ' + e
        })
    }
}

                     function AsignarCaja() {

                $.ajax({
                    type: 'GET',
                    dataType: 'json',
                    url: '@Url.Page("Index", "AsignarCaja")',
                    data: { id: ids, idCaja: $("#selectC").val() },
                    success: function (result) {

                        if (result == false) {
                            ids = 0;
                            Swal.fire({
                                icon: 'error',
                                title: 'Oops...',
                                text: 'Ha ocurrido un error al intentar procesar la solicitud'

                            })

                        } else {
                            Swal.fire({
                                title: "Ha sido asignado con éxito",

                                icon: 'success',
                                showCancelButton: false,
                                customClass: {
                                    confirmButton: 'swalBtnColor',

                                },
                                confirmButtonText: 'OK'
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    location.reload();
                                }
                            })
                        }
                    },
                    beforeSend: function () {

                    }
                })
            }
    </script>
}
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>
            Documentos
        </h1>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#"><i class="ti-dashboard"></i></a></li>
            <li class="breadcrumb-item active">Listado Documentos</li>
        </ol>
    </section>
    <!-- Main content -->
    <section class="content">
        <div class="row">
            <div class="col-12">

                <div class="box">
                    <div class="box-header with-border">
                        <div class="row">
                            <div class="col-sm-6"> <h4 class="box-title">Documentos</h4></div>
                        @if(Model.Parametros.FirstOrDefault().Pais == "C")
                        {
                             <div class="col-sm-3"> <button onclick="javascript: ActualizarConsecutivos()" class="btn btn-rounded btn-success"><i class="mdi mdi-cached"></i  title="Actualizar Consecutivos"> Actualizar Consecutivos</button></div>
                             <div class="col-sm-3"> <button onclick="javascript: EnviarConsecutivos()" class="btn btn-rounded btn-success"><i class="mdi mdi-cached"></i  title="Actualizar Consecutivos"> Enviar a Hacienda</button></div>
                        }
                       

                        </div>


                    </div>
                    <div class="box-body">
                        <form method="get">
                            <div class="row">
                                <div class="col-sm-2 pr-1">
                                    <div class="form-group">
                                        <label>Fecha Inicial</label>
                                        <input class="form-control " id="FecInicial" type="date" asp-for="filtro.FechaInicial">
                                    </div>


                                </div>

                                <div class="col-sm-2 pl-1">
                                    <div class="form-group">
                                        <label>Fecha Final</label>
                                        <input class="form-control" id="FecFinal" type="date" asp-for="filtro.FechaFinal">
                                    </div>
                                </div>

                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="cyber">Tipo de Documento:</label>
                                        <select class="form-control" id="selectTD" asp-for="filtro.CardCode" required>
                                            <option value="01">Factura Electrónica</option>
                                            <option value="03">Nota de Crédito</option>
                                            <option value="04">Tiquete Electrónico</option>





                                        </select>
                                    </div>
                                </div>

                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="cyber">Cliente:</label>
                                        <select class="form-control select2" id="ClienteF" asp-for="filtro.Codigo1" required>
                                            <option value="0"> Seleccione</option>

                                            @foreach (var item in Model.Clientes)
                                        {
                                            <option value="@item.id"> @item.Codigo - @item.Nombre</option>
                                        }


                                    </select>





                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label for="cyber">Usuario:</label>
                                    <select class="form-control select2" id="UsuarioF" asp-for="filtro.Codigo2" required>
                                        <option value="0"> Seleccione</option>

                                        @foreach (var item in Model.Users)
                                        {
                                            <option value="@item.id">@item.Nombre</option>
                                        }


                                    </select>






                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="form-group">
                                    <label for="cyber">Cond Pago:</label>
                                    <select class="form-control select2" id="Condicion" asp-for="filtro.Codigo4" required>
                                        <option value="0"> Seleccione</option>

                                        @foreach (var item in Model.Condicion)
                                        {
                                            <option value="@item.id">@item.Nombre</option>
                                        }


                                    </select>






                                </div>
                            </div>

                               

                            <div class="col-md-2">
                                <div class="form-group">
                                    <label for="cyber">Vendedor:</label>
                                    <select class="form-control select2" id="Vendedor" asp-for="filtro.Codigo5" required>
                                        <option value="0"> Seleccione</option>

                                        @foreach (var item in Model.Vendedor)
                                        {
                                            <option value="@item.id">@item.Nombre</option>
                                        }


                                    </select>






                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label for="cyber">Estado:</label>
                                    <select class="form-control" id="Estado" asp-for="filtro.ItemCode" required>
                                        <option value="0">Abierta</option>
                                        <option value="1">Cerrada</option>





                                    </select>
                                </div>
                            </div>

                               <div class="col-md-2">
                                <div class="form-group">
                                    <label for="cyber">Caja:</label>
                                    <select class="form-control select2" id="Caja" asp-for="filtro.Codigo6" required>
                                        <option value="0"> Seleccione</option>

                                        @foreach (var item in Model.Cajas)
                                        {
                                            <option value="@item.id">@item.Nombre</option>
                                        }


                                    </select>






                                </div>
                            </div>

                           
                             <div class="col-md-2">
                                    <div class="form-group">
                                        <label for="cyber">Respuesta Hacienda:</label>
                                        <select class="form-control select2" id="selectR" asp-for="filtro.Respuesta" required>
                                            <option value="0">Seleccione</option>
                                            <option value="procesando">Procesando</option>
                                            <option value="aceptado">Aprobado</option>
                                            <option value="rechazado">Rechazado</option>





                                        </select>
                                    </div>
                                </div>
                               <div class="col-md-1 " style="text-align: center; padding-top: 2%;">
                                <input type="checkbox" id="md_checkbox_1" class="chk-col-red" asp-for="filtro.Procesado" onclick="this.form.submit()" />
                                <label for="md_checkbox_1"> Procesado SAP</label>
                            </div>

                            
                               <div class="col-2 " style="text-align: center; padding-top: 2%;">
                                <input type="checkbox" id="md_checkbox_2" class="chk-col-red" asp-for="filtro.PagoProcesado" onclick="this.form.submit()" />
                                <label for="md_checkbox_2"> Pago Procesado SAP</label>
                            </div>


                                                  <div class="col-1 " style="text-align: center; padding-top: 2%;">
                                <input type="checkbox" id="md_checkbox_3" class="chk-col-red" asp-for="filtro.interes" onclick="this.form.submit()" />
                                <label for="md_checkbox_3"> Interes</label>
                            </div>


                                

                            <div class="col-sm-12 pl-1" style="text-align: right; padding-top: 2%;">
                                <button title="Buscar" type="submit" class="btn btn-rounded btn-outline-primary"> <i class="fa fa-search"></i></button>
                            </div>




                        </div>

                    </form>
                </div>
            </div>


            <div class="box">
                <div class="box-header with-border">
                    <div class="row">
                        <div class="col-sm-8"> <h4 class="box-title">Documentos</h4></div>
                        <div class="col-sm-4">  </div>

                    </div>


                </div>
                <!-- /.box-header -->
                <div class="box-body">
                    <div class="table-responsive">
                        <table id="example1" class="table table-bordered table-striped">
                            <thead>
                                <tr>

                                    <th>ID</th>
                                    <th>Acción</th>
                                    <th>Caja</th>
                                    <th>Cliente</th>
                                    <th>Vendedor</th>
                                    <th>Fecha Creado</th>

                                    <th>Tipo Doc</th>
                                    <th>Condición Pago</th>
                                    <th>Moneda</th>

                                    <th>SubTotal</th>
                                    <th>Descuento</th>
                                    <th>Impuesto</th>

                                    <th>Total</th>
                                    <th>Estado</th>
                                    <th>Procesado SAP</th>
                                    <th>Pago SAP</th>
                                    <th>Generado Por</th>
                                        @if (Model.Parametros.FirstOrDefault().Pais == "C")
                                        {
                                    <th>Respuesta Hacienda</th>
                                        }
                                    <th>Validado</th>



                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Listas)
                                {
                                    <tr>


                                     
                                        @if (Model.Parametros.FirstOrDefault().ConsecutivoManual)
                                        {
                                            <td>
                                                @item.ConsecutivoManual
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                @item.id
                                            </td>
                                        }

                                        <td align="center" style="padding-top:15px;">

                                         
                                            <a asp-page="./Observar" asp-route-id="@item.id" class="fa fa-info-circle icono"> </a> &nbsp;
                                         
                                            @if (item.ProcesadaSAP == false)
                                            {
                                                <a onclick="javascript: onClickModal('@item.id')" title="Insertar a SAP"><img src="/sapX.png" /></a>
                                            }
                                                      <a onclick="javascript: AbrirModalAgregarCliente('@item.id', '@item.CodSuc')" class="fa  fa-user-plus icono"></a>
                                        </td>
                                         <td>
                                            @(Model.Cajas.Where(a => a.id == item.idCaja).FirstOrDefault() == null ? "Caja Inexistente": Model.Cajas.Where(a => a.id == item.idCaja).FirstOrDefault().Nombre )
                                        </td>
                                        <td>
                                            @( Model.Clientes.Where(a => a.id == item.idCliente).FirstOrDefault() == null ? "Cliente Inexistente" :  Model.Clientes.Where(a => a.id == item.idCliente).FirstOrDefault().Codigo + " - " +  Model.Clientes.Where(a => a.id == item.idCliente).FirstOrDefault().Nombre)
                                        </td>
                                        <td>
                                            @(Model.Vendedor.Where(a => a.id == item.idVendedor).FirstOrDefault() == null ? "Vendedor Inexistente": Model.Vendedor.Where(a => a.id == item.idVendedor).FirstOrDefault().Nombre )

                                        </td>
                                        <td>
                                            @item.Fecha.ToString("dd/MM/yyyy")
                                        </td>
                                        <td>
                                            @switch (item.TipoDocumento)
                                            {
                                                case "01":
                                                    {
                                                        <p>Factura Electrónica</p>
                                                        break;
                                                    }
                                                case "03":
                                                    {
                                                        <p>Nota de Crédito</p>
                                                        break;
                                                    }

                                                case "04":
                                                    {
                                                        <p>Tiquete Electrónico</p>
                                                        break;
                                                    }
                                            }
                                        </td>
                                        <td>
                                            @(Model.Condicion.Where(a => a.id == item.idCondPago).FirstOrDefault() == null ? "": Model.Condicion.Where(a => a.id == item.idCondPago).FirstOrDefault().Nombre )

                                        </td>
                                        <td>
                                            @item.Moneda
                                        </td>
                                        <td>
                                            @Math.Round(@item.Subtotal, 2).ToString("C",formato)
                                        </td>
                                        <td>
                                            @Math.Round(@item.TotalDescuento, 2).ToString("C",formato)
                                        </td>

                                        <td>
                                            @Math.Round(@item.TotalImpuestos, 2).ToString("C",formato)
                                        </td>
                                        <td>
                                            @Math.Round(@item.TotalCompra + item.Redondeo, 2).ToString("C",formato)
                                        </td>

                                        <td>
                                            @if (item.Status == "0")
                                            {
                                                <span class="badge badge-pill badge-success">Abierto</span>

                                            }
                                            else
                                            {
                                                <span class="badge badge-pill badge-danger">Cerrado</span>
                                            }
                                        </td>
                                          <td>
                                            @if (item.ProcesadaSAP)
                                            {
                                                <span class="badge badge-pill badge-success">Procesado</span>

                                            }
                                            else
                                            {
                                                <span class="badge badge-pill badge-danger">Sin Procesar</span>
                                            }
                                        </td>
                                          <td>
                                            @if (item.PagoProcesadaSAP)
                                            {
                                                <span class="badge badge-pill badge-success">Procesado</span>

                                            }
                                            else
                                            {
                                                <span class="badge badge-pill badge-danger">Sin Procesar</span>
                                            }
                                        </td>

                                        <td>
                                            @(Model.Users.Where(a => a.id == item.idUsuarioCreador).FirstOrDefault() == null ? "": Model.Users.Where(a => a.id == item.idUsuarioCreador).FirstOrDefault().Nombre )

                                        </td>
                                            @if (Model.Parametros.FirstOrDefault().Pais == "C")
                                        {
                                            <td>
                                                @{
                                                    switch (item.RespuestaHacienda)
                                                    {
                                                        case "rechazado":
                                                            {
                                                                <span class="badge badge-pill badge-danger">Rechazado</span>
                                                                break;
                                                            }
                                                        case "aceptado":
                                                            {
                                                                <span class="badge badge-pill badge-success">Aprobado</span>
                                                                break;
                                                            }
                                                        case "procesando":
                                                            {
                                                                <span class="badge badge-pill badge-info">Procesando</span>
                                                                break;
                                                            }

                                                    }


                                                }
                                            </td>
                                        }
                                        <td>
                                            @if (item.Validado)
                                            {
                                                <span class="badge badge-pill badge-success">Validado</span>

                                            }
                                            else
                                            {
                                                <span class="badge badge-pill badge-danger">Sin Validar</span>
                                            }
                                        </td>






                                    </tr>

                                }


                            </tbody>
                            <tfoot>
                                <tr>

                                    <th>ID</th>
                                    <th>Acción</th>
                                    <th>Caja</th>
                                    <th>Cliente</th>
                                    <th>Vendedor</th>
                                    <th>Fecha Creado</th>

                                    <th>Tipo Doc</th>
                                    <th>Condición Pago</th>
                                    <th>Moneda</th>

                                    <th>SubTotal</th>
                                    <th>Descuento</th>
                                    <th>Impuesto</th>
                                    <th>Total</th>
                                    <th>Estado</th>
                                    <th>Procesado SAP</th>
                                    <th>Pago SAP</th>
                                    <th>Generado Por</th>
                                        @if (Model.Parametros.FirstOrDefault().Pais == "C")
                                        {
                                     <th>Respuesta Hacienda</th>
                                        }
                                    <th>Validado</th>




                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
                <!-- /.box-body -->
            </div>
            <!-- /.box -->
        </div>
        <!-- /.col -->
    </div>
    <!-- /.row -->
</section>
<!-- /.content -->
<!--Modal para agregar Clientes-->


<div class="modal fade bs-example-modal-lg" id="ModalAgregarCliente" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="myLargeModalLabel">Asignar Caja</h4>
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
            </div>
            <div class="modal-body">

                <div class="row">

                    <div class="col-md-12">
                        <div class="form-group">
                            <label for="nom">Caja:</label>
                        <select id="selectC" class="form-control select2" required>
</select>

                        </div>


                    </div>


                </div>


            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary waves-effect text-left" onclick="javascript: AsignarCaja();">Asignar</button> &nbsp;
                <button type="button" class="btn btn-danger waves-effect text-left" data-dismiss="modal">Cancelar</button> &nbsp;


            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>