                                            <td class="text-center"> Fact </td>
                                            <td class="text-center">   @Math.Round(@item.Saldo, 2).ToString("C", formato) </td>

                                            <td class="text-center">  @Math.Round(@item.Intereses, 2).ToString("C", formato) </td>
                                            <td class="text-center">  @Math.Round(@item.SinVen, 2).ToString("C", formato) </td>



                                        </tr>
                                        SaldoDolares += @item.Saldo;
                                        SaldoAcumDolares += @item.SinVen;
                                    }

                                </tbody>
                            </table>
                        </div>
                        <!-- /.col -->

                        <div class="col-md-12  text-right">


                            <div>
                                <p>Moneda  : <span> USD</span> </p>


                            </div>
                            <div class="total-payment">
                                <h3><b>Saldo  :</b>  <span>@Math.Round(SaldoDolares, 2).ToString("C", formato) </span></h3>
                            </div>

                            <div class="total-payment">
                                <h3><b>Saldo Acumulado  :</b>  <span>@Math.Round(SaldoAcumDolares, 2).ToString("C", formato) </span></h3>
                            </div>


                        </div>
                    </div>
                    <!-- /.row -->
                    <!-- /.row -->

                </div>
            </div>

        </div>
    </div>




</section>


