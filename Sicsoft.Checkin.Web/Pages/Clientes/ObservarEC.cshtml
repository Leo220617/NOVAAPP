                                        <th class="text-center">Días V.</th>
                                        <th class="text-center">Tipo Doc.</th>
                                        <th class="text-center">Saldo</th>
                                        <th class="text-center">Intereses</th>
                                        <th class="text-center">Saldo Acum</th>





                                    </tr>
                                </thead>
                                <tbody>

                                    @{
                                        var SaldoDolares = 0.0m;
                                        var SaldoAcumDolares = 0.0m;
                                    }
