@section scripts {

    <script>
        $(document).ready(function () {
            jQuery(document).ready(function ($) {
                Recuperar();
                RellenaCabys();
            });



            $(document).ready(function () {

            });


        });
        var ProdCadena = [];
        var CabysMios = [];
        var Cabys = [];
        function RellenaCabys() {
            $("#selectCabys").html("");
            var text = "";

            text += "<option value='0' > Seleccione Cabys </option>";
            for (var i = 0; i < Cabys.length; i++) {
                text += "<option value='" + Cabys[i].CodCabys + "-" + Cabys[i].Descripcion + "'> " + Cabys[i].CodCabys + "-" + Cabys[i].Descripcion + " </option> ";

            }

            $("#selectCabys").html(text);

        }
        function Recuperar() {
            try {
                CabysMios = JSON.parse($("#CabysMios").val());
                Cabys = JSON.parse($("#CabysLista").val());

                for (var i = 0; i < CabysMios.length; i++) {
                    var Detalle = {
                        id: 0,
                        idEncabezado: 0,
                        CodCabys: CabysMios[i].CodCabys,
                        Descripcion: Cabys.find(a => a.CodCabys == CabysMios[i].CodCabys).Descripcion
                    }

                    ProdCadena.push(Detalle);
                }

                RellenaTabla();

            } catch (e) {
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: 'Ha ocurrido un error al intentar recuperar ' + e

                })
            }
        }

        function onClickAgregar() {
            try {
                var CabysS = $("#selectCabys").val();

                var Detalle = {
                    id: 0,
                    idEncabezado: 0,
                    CodCabys: CabysS.split("-")[0],
                    Descripcion: CabysS.split("-")[1]
                }
                $("#selectCabys").val("0").trigger("change");
                ProdCadena.push(Detalle);
                RellenaTabla();
            } catch (e) {
                console.log(e);
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: 'Ha ocurrido un error al intentar imprimir ' + e

                })
            }
        }

        function RellenaTabla() {

            try {
                $("#tbody").html("");

                var text = "";

                for (var i = 0; i < ProdCadena.length; i++) {
                    text += "<tr>";
                    text += "<td>" + i + " </td>";
                    text += "<td>" + ProdCadena[i].CodCabys + " - " + ProdCadena[i].Descripcion + " </td>";
                    text += "<td class='text-center'> <a class='fa fa-trash' onclick='javascript:EliminarProducto(" + i + ") '> </a></td>";
                    text += "</tr>";
                }

                $("#tbody").html(text);
            } catch (e) {
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: 'Ha ocurrido un error al intentar recuperar ' + e

                })
            }





        }

        function EliminarProducto(i) {
            try {
                ProdCadena.splice(i, 1);
                RellenaTabla();
            } catch (e) {
                console.log(e);
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: 'Ha ocurrido un error al intentar imprimir ' + e

                })
            }
        }

        function Generar() {
            try {
                onChangeInstitucion();
                var Exoneracion = {
                    id: $("#id").val(),
                    TipoDoc: $("#selectTD").val(),
                    NumDoc: $("#NumDoc").val(),
                    NomInst: $("#NomInst").val(),
                    FechaEmision: $("#FecEmi").val(),
                    PorExon: $("#PorExon").val(),
                    idCliente: $("#Cliente").val(),
                    FechaVencimiento: $("#FecVen").val(),
                    Imagen: $("#Imagen").val(),
                    idImpuesto: $("#Impuesto").val(),
                    CodigoInstitucion: $("#CodigoInstitucion").val(),
                    NombreInstitucionOtro: $("#NomInstOtro").val(),
                    ArticuloLey: $("#ArticuloLey").val(),
                    IncisoLey: $("#IncisoLey").val(),
                    TipoDocumentoOtro: $("#TipoDocOtro").val(),
                    Detalle: ProdCadena
                };

                if (validar(Exoneracion)) {
                    Swal.fire({
                        title: '¿Desea guardar la exoneracion?',
                        showDenyButton: true,
                        showCancelButton: false,
                        confirmButtonText: `Aceptar`,
                        denyButtonText: `Cancelar`,
                        customClass: {
                            confirmButton: 'swalBtnColor',
                            denyButton: 'swalDeny'
                        },
                    }).then((result) => {
                        if (result.isConfirmed) {



                            $.ajax({
                                type: 'POST',

                                url: '@Url.Page("Editar", "AgregarExoneracion")',
                                dataType: 'json',
                                data: { recibidos: Exoneracion },
                                headers: {
                                    RequestVerificationToken: $('input:hidden[name="__RequestVerificationToken"]').val()
                                },
                                success: function (json) {



                                    if (json.success == true) {
                                        Swal.fire({
                                            title: "Ha sido generado con éxito",

                                            icon: 'success',
                                            showCancelButton: false,

                                            confirmButtonText: 'OK',
                                            customClass: {
                                                confirmButton: 'swalBtnColor',

                                            },
                                        }).then((result) => {
                                            if (result.isConfirmed) {
                                                //Despues de insertar, ocupariamos el id del cliente en la bd
                                                //para entonces setearlo en el array de clientes

                                                window.location.href = window.location.href.split("/Editar")[0];


                                            }
                                        })

                                    } else {

                                        Swal.fire({
                                            icon: 'error',
                                            title: 'Oops...',
                                            text: 'Ha ocurrido un error al intentar editar'

                                        })
                                    }
                                },

                                beforeSend: function (xhr) {


                                },
                                complete: function () {

                                },
                                error: function (error) {


                                }
                            });
                        }
                    })
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: 'Parece que faltan datos por rellenar'

                    })
                }

            } catch (e) {
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: 'Ha ocurrido un error al intentar editar ' + e

                })
            }
        }

        function validar(e) {
            if (e.NumDoc == "" || e.NumDoc == null || e.NumDoc == undefined) {
                return false;
            } else if (e.NomInst == "" || e.NomInst == null || e.NomInst == undefined) {
                return false;

            } else if (e.PorExon == "" || e.PorExon == null || e.PorExon == undefined) {
                return false;

            } else if (e.idCliente == "" || e.idCliente == null || e.idCliente == undefined) {
                return false;
            } else if (e.CodigoInstitucion == "" || e.CodigoInstitucion == null || e.CodigoInstitucion == undefined) {
                return false;
            } else if (e.idImpuesto == "" || e.idImpuesto == null || e.idImpuesto == undefined || e.idImpuesto == 0) {
                return false;
            } else if (e.CodigoInstitucion == "99" && (e.NombreInstitucionOtro == "" || e.NombreInstitucionOtro == undefined || e.NombreInstitucionOtro == null)) {
                return false;
            } else if (e.TipoDoc == "99" && (e.TipoDocumentoOtro == "" || e.TipoDocumentoOtro == undefined || e.TipoDocumentoOtro == null)) {
                return false;
            }

            else {
                return true;
            }


        }
        function onChangeInstitucion() {
            try {
                var Institucion = $("#CodigoInstitucion").val();
                var nombre = "";

                switch (Institucion) {
                    case "01": nombre = "Ministerio de Hacienda"; break;
                    case "02": nombre = "Ministerio de Relaciones Exteriores y Culto"; break;
                    case "03": nombre = "Ministerio de Agricultura y Ganadería"; break;
                    case "04": nombre = "Ministerio de Economía, Industria y Comercio"; break;
                    case "05": nombre = "Cruz Roja Costarricense"; break;
                    case "06": nombre = "Benemérito Cuerpo de Bomberos de Costa Rica"; break;
                    case "07": nombre = "Asociación Obras del Espíritu Santo"; break;
                    case "08": nombre = "Federación Cruzada Nacional de protección al Anciano (Fecrun)"; break;
                    case "09": nombre = "Escuela de Agricultura de la Región Húmeda (EARTH)"; break;
                    case "10": nombre = "Instituto Centroamericano de Administración de Empresas (INC)"; break;
                    case "11": nombre = "Junta de Protección Social (JPS)"; break;
                    case "12": nombre = "Autoridad Reguladora de los Servicios Públicos (Aresep)"; break;
                    case "99": nombre = "Otros"; break;
                    default: nombre = ""; break;
                }
                $("#NomInst").val(nombre);
                if (Institucion == "99") {
                    $("#DivNomInstOtro").prop("hidden", false);
                } else {
                    $("#DivNomInstOtro").prop("hidden", true);
                }


            } catch (e) {
                console.log(e);
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: 'Ha ocurrido un error al intentar imprimir ' + e

                })
            }
        }
        function onChangeTipoDoc() {
            try {
                var TipoDoc = $("#selectTD").val();

                if (TipoDoc == "99") {
                    $("#DivTD").prop("hidden", false);
                } else {
                    $("#DivTD").prop("hidden", true);
                }


            } catch (e) {
                console.log(e);
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: 'Ha ocurrido un error al intentar imprimir ' + e

                })
            }
        }
        function onChangeImpuesto() {
            try {
                var Impuestos = JSON.parse($("#Impuestos").val());

                var MiImpuesto = $("#Impuesto").val();

                var IMP = Impuestos.find(a => a.id == MiImpuesto);
                var valor = 13 - IMP.Tarifa;
                $("#PorExon").val(valor);


            } catch (e) {
                console.log(e);
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: 'Ha ocurrido un error al intentar imprimir ' + e

                })
            }
        }
    </script>
    <script>
        var ImageBae64 = '';

        var fileUploadPrincipal = document.getElementById('imgPrincipalUploadG');
        fileUploadPrincipal.onchange = async function (e) {

            await readFilePrincipalP(e.srcElement);
            // idF = setInterval(cancelar(e), 2000);

            var idF = setInterval(async function () {

                if (ImageBae64 != "data:," && $("#base64").val() != "data:,") {
                    //alert("Imagen agregada con éxito");
                    clearInterval(idF);
                } else {
                    await readFilePrincipalP(e.srcElement);
                }
            }, 1500);



        }
        async function readFilePrincipalP(input) {

            if (input.files && input.files[0]) {
                /*const maxAllowSize = 512000;*/
                //const maxAllowSize = 2800000;
                const maxAllowSize = 5000000;
                if (input.files[0].size > maxAllowSize) {
                    alert("Esta imagen es muy pesada");
                    input.value = '';
                } else {
                    var reader = new FileReader();
                    var img = document.createElement("img");
                    var canvas = document.createElement('canvas');

                    reader.onload = function (e) {
                        img.src = e.target.result;
                        var ctx = canvas.getContext("2d");
                        ctx.drawImage(img, 0, 0);

                        var MAX_WIDTH = 800;
                        var MAX_HEIGHT = 600;
                        var width = img.width;
                        var height = img.height;

                        if (width > height) {
                            if (width > MAX_WIDTH) {
                                height *= MAX_WIDTH / width;
                                width = MAX_WIDTH;
                            }
                        } else {
                            if (height > MAX_HEIGHT) {
                                width *= MAX_HEIGHT / height;
                                height = MAX_HEIGHT;
                            }
                        }
                        canvas.width = width;
                        canvas.height = height;
                        var ctx = canvas.getContext("2d");
                        ctx.drawImage(img, 0, 0, width, height);
                        var dataurl = canvas.toDataURL("image/jpg");
                        document.getElementById('imgPrincipalG').src = e.target.result;

                        ImageBae64 = dataurl;
                        $("#Imagen").val(ImageBae64);
                        //    IMG2 = e.target.result;

                    }

                }

                reader.readAsDataURL(input.files[0]);
            }



        }

    </script>

}

