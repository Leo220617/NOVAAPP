                                <div class="controls">
                                    <input type="text" asp-for="Exoneracion.NumDoc" id="NumDoc" class="form-control" required data-validation-required-message="Este campo es requerido">
                                </div>

                            </div>

                        </div>



                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="cyber">Nombre de Institución:</label>
                                <select class="form-control select2" onchange="javascript: onChangeInstitucion();" id="CodigoInstitucion"  asp-for="Exoneracion.CodigoInstitucion" required>
