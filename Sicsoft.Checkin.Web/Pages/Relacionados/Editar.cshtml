@page "{id}"
@model NOVAAPP.Pages.Relacionados.EditarModel
@{
    ViewData["Title"] = "Relacionados";
}
@using Microsoft.AspNetCore.Http
@using System;
@using System.Collections.Generic;
@using System.IO;
@using System.Linq;
@using System.Security.Claims;
@using System.Threading.Tasks;
@using Microsoft.AspNetCore.Mvc;
@using Microsoft.AspNetCore.Mvc.RazorPages;
@using Microsoft.Extensions.Configuration;
@using Refit;
@using Sicsoft.Checkin.Web.Models;
@inject IHttpContextAccessor httpContextAccessor
@{
    var Roles = ((ClaimsIdentity)User.Identity).Claims.Where(d => d.Type == "Roles").Select(s1 => s1.Value).FirstOrDefault().Split("|");
}
@section styles {
    <style>
        .resultados-busqueda {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            z-index: 1000;
            max-height: 250px;
            overflow-y: auto;
            display: none;
        }

            .resultados-busqueda .list-group-item {
                cursor: pointer;
            }

                .resultados-busqueda .list-group-item:hover {
                    background-color: #f0f0f0;
    </style>

}

}
@section scripts {


    <script src="/js/Relacionados/EditarRelacionados.js"></script>


}


@using Newtonsoft.Json;
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Relación
    </h1>
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#"><i class="ti-dashboard"></i></a></li>
        <li class="breadcrumb-item active">Generar Relación</li>
    </ol>
</section>

<section class="content ">
    <div class="row">
        <div class="col-12">


            <input hidden asp-for="Relacion.id" id="id" />
            <input hidden id="Productos" value="@JsonConvert.SerializeObject(Model.Productos)" />
            <input hidden id="Categorias" value="@JsonConvert.SerializeObject(Model.Categoria)" />
            <input hidden id="Relacion" value="@JsonConvert.SerializeObject(Model.Relacion)" />
            <input hidden id="urlGenerar" value="@Url.Page("Editar", "AgregarRelacion")" />
            <!-- Content Header (Page header) -->
            <div class="box">
                <div class="box-header with-border">
                    <div class="row">
                        <div class="col-8">
                            <h6 class="box-subtitle">Generar Relación</h6>


                        </div>
                        <div class="col-4">
                            <a asp-page="./Index" class="nav-link text-dark" style="text-decoration: underline;"><i class="ti-back-left "></i>  Regresar</a>


                        </div>
                    </div>
                </div>
                <div class="box-body">
                    <!-- title row -->
                    <div class="row">
                        <div class="col-md-3">
                            <div class="page-header mt-0">
                                <h2 class="d-inline"><span class="font-size-24">Relación</span></h2>
                                <div class="text-left">
                                    <h5>Fecha <span class="font-size-18">@DateTime.Now.ToString("dd MMM yyy")</span></h5>
                                    <input hidden id="Fecha" type="datetime" value="@DateTime.Now" />



                                </div>

                            </div>

                        </div>

                        <!-- /.col -->
                    </div>
                    <!-- info row -->
                    <!-- /.col -->
                    <!-- /.row -->
                    <div class="row invoice-info">
                        <div class="col-md-4 pr-1">
                            <div class="form-group">
                                <label>Nombre</label>
                                <input id="inputNombre" type="text" class="form-control" placeholder="Nombre">


                            </div>


                        </div>



                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Categoria</label>
                                <select id="CategoriaSeleccionado" class="form-control select2" onchange="javascript: onChangeCategoria()">
                                    <option value="0"> Seleccione Categoria</option>



                                </select>
                            </div>
                        </div>


                        <div class="col-md-4">
                            <br><br>
                            <br><br>



                        </div>





                    </div>
                </div>

            </div>

            <div class="box">
                <div class="box-body">
                    <div class="row">


                        <div class="col-md-12  ">
                            <div class="x_panel">
                                <div class="x_content">



                                    <div class="row">
                                        <div class="col-md-6">
                                            <h3>Productos</h3>
                                        </div>
                                    </div>


                                </div>
                                <div class="x_content">



                                    <div class="row">
                                        <div class="col-md-9">
                                            <h2>Buscar Producto</h2>
                                            <input type="text" id="buscadorProducto" placeholder="Buscar por código o nombre...">
                                            <div id="resultadosProducto" style="display: none;"></div>
                                            <input hidden id="ProductoSeleccionado" />
                                        </div>

                                    </div>
                                    <br />
                                    <div class="row">

                                        <div class="col-md-12">
                                            <div class="form-group">
                                                <label>Nombre Producto</label>
                                                <input id="inputNomPro" disabled type="text" class="form-control" placeholder="Nombre Producto">


                                            </div>


                                        </div>



                                    </div>

                                    <br />

                                    <div class="row">

                                        <div class="col-sm-12 pl-1" style="text-align: right;">

                                            <a id="agregar" onclick="javascript: AgregarProductoTabla();" class="btn btn-primary" style="color: white !important;">+ Agregar </a>
                                        </div>



                                    </div>




                                </div>
                            </div>
                        </div>








                    </div>
                </div>
            </div>


            <div class="box">
                <div class="box-body">
                    <!-- Table row -->
                    <div class="row">

                        <div class="col-12 table-responsive">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Descripción</th>


                                        <th class="text-right">Eliminar</th>


                                    </tr>
                                </thead>
                                <tbody id="tbody">
                                </tbody>
                            </table>
                        </div>
                        <!-- /.col -->
                    </div>
                    <!-- /.row -->
                    <!-- /.row -->

                </div>
            </div>


            <div class="box">
                <div class="box-body">

                    <!-- this row will not appear when printing -->
                    <div class="row no-print">
                        <div class="col-12">
                            @*<button id="print" class="btn btn-warning" type="button"> <span><i class="fa fa-print"></i> Imprimir</span> </button>*@
                            <button type="button" class="btn btn-success pull-right" onclick="    javascript: Generar()">
                                <i class="fa fa-credit-card"></i> Generar
                            </button>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>





