@page
@using System.Globalization
@model NOVAAPP.Pages.ReporteVendedoresVentas.Index2Model
@{
    ViewData["Title"] = "ReporteVendedoresVentas";
    NumberFormatInfo formato = new CultureInfo("es-CR").NumberFormat;
    formato.CurrencySymbol = "";
    formato.CurrencyGroupSeparator = ",";
    formato.NumberDecimalSeparator = ".";

}



@section styles {


}

@section scripts {


}



<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Reporte Ventas Vendedores
    </h1>
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#"><i class="ti-dashboard"></i></a></li>
        <li class="breadcrumb-item active">Reporte Ventas Vendedores</li>
    </ol>
</section>
<!-- Main content -->
<section class="content">
    <div class="row">
        <div class="col-12">
            <div class="box">
                <div class="box-header with-border">
                    <div class="row">
                        <div class="col-sm-8"> <h4 class="box-title">Filtro</h4></div>


                    </div>


                </div>
                <div class="box-body">
                    <form method="get">
                        <div class="row">
                            <div class="col-sm-2 pr-1">
                                <div class="form-group">
                                    <label>Fecha Inicial</label>
                                    <input class="form-control " id="FecInicial" type="date" asp-for="filtro.FechaInicial">
                                </div>


                            </div>

                            <div class="col-sm-2 pl-1">
                                <div class="form-group">
                                    <label>Fecha Final</label>
                                    <input class="form-control" id="FecFinal" type="date" asp-for="filtro.FechaFinal">
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="form-group">
                                    <label for="cyber">Vendedor:</label>
                                    <select class="form-control select2" id="Vendedor" asp-for="filtro.Codigo1" required>
                                        <option value="0"> Seleccione</option>

                                        @foreach (var item in Model.Vendedores)
                                        {
                                            <option value="@item.id">@item.CodSAP - @item.Nombre</option>
                                        }


                                    </select>






                                </div>
                            </div>


                            <div class="col-md-2">
                                <div class="form-group">
                                    <label for="cyber">Sucursal:</label>
                                    <select class="form-control select2" id="Sucursal" asp-for="filtro.CardCode" required>
                                        <option value="0"> Seleccione</option>

                                        @foreach (var item in Model.Sucursales)
                                        {
                                            <option value="@item.CodSuc">@item.CodSuc - @item.Nombre</option>
                                        }


                                    </select>






                                </div>
                            </div>


                            <div class="col-sm-2 pl-1" style="text-align: center; padding-top: 1%;">
                                <button title="Buscar" type="submit" class="btn btn-rounded btn-outline-primary"> <i class="fa fa-search"></i></button>
                            </div>




                        </div>

                    </form>
                </div>
            </div>
            <div class="box">
                <div class="box-header with-border">
                    <div class="row">
                        <div class="col-sm-8"> <h4 class="box-title">Reporte Ventas Vendedor</h4></div>



                    </div>


                </div>
                <!-- /.box-header -->
                <div class="box-body">
                    <div class="table-responsive">
                        <table id="example1" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Vendedor</th>
                                    <th>Total</th>
                                    <th>Fecha Actual</th>




                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ReporteVentasVendedores)
                                {
                                    <tr>
                                        <td>
                                            @(Model.Vendedores.Where(a => a.id == item.idVendedor).FirstOrDefault() == null ? "Vendedor Inexistente" : Model.Vendedores.Where(a => a.id == item.idVendedor).FirstOrDefault().Nombre)
                                        </td>
                                        <td>
                                            ₡@Math.Round(@item.Totalizado, 2).ToString("C", formato)
                                        </td>
                                        <td>@DateTime.Now </td>




                                    </tr>
                                }


                            </tbody>
                            <tfoot>
                                <tr>
                                    <th>Vendedor</th>
                                    <th>Total</th>
                                    <th>Fecha Actual</th>


                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
                <!-- /.box-body -->
            </div>
            <!-- /.box -->
        </div>
        <!-- /.col -->
    </div>
    <!-- /.row -->
</section>
<!-- /.content -->
