@page "{idListaPrecio}/{idCategoria}/{Moneda}"
@model NOVAAPP.Pages.Margenes.EditarModel
@{
    ViewData["Title"] = "Margenes";
    NumberFormatInfo formato = new CultureInfo("es-CR").NumberFormat;
    formato.CurrencySymbol = "";
    formato.CurrencyGroupSeparator = ",";
    formato.NumberDecimalSeparator = ".";
}
@using Microsoft.AspNetCore.Http
@using System;
@using System.Collections.Generic;
@using System.IO;
@using System.Linq;
@using System.Security.Claims;
@using System.Threading.Tasks;
@using Microsoft.AspNetCore.Mvc;
@using Microsoft.AspNetCore.Mvc.RazorPages;
@using Microsoft.Extensions.Configuration;
@using Refit;
@using Sicsoft.Checkin.Web.Models;
@inject IHttpContextAccessor httpContextAccessor
@{
    var Roles = ((ClaimsIdentity)User.Identity).Claims.Where(d => d.Type == "Roles").Select(s1 => s1.Value).FirstOrDefault().Split("|");
}
@section styles{
    <style>
        .tableFixHead th {
            position: sticky;
            top: 0;
            background: white;
        }

        /* CONTENEDOR QUE ROMPE CLIPPING DE PADRES */
        #force-scroll-x {
            height: 500px;
            max-width: 100vw;
            overflow-x: auto !important;
            overflow-y: auto !important;
            position: relative;
            transform: translateZ(0); /* 🔥 CLAVE */
        }

            /* FUERZA ANCHO REAL DE LA TABLA */
            #force-scroll-x table {
                width: auto !important;
                min-width: auto !important;
                table-layout: fixed;

               
                height: 500px;
            }

      

            /* HEADER FIJO */
            #force-scroll-x thead th {
                position: sticky;
                top: 0;
                z-index: 10;
                background: #17a2b8;
                color: white;
            }


    </style>

}
@section scripts{

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.body.style.overflowX = "auto";
            document.documentElement.style.overflowX = "auto";
        });
    </script>

    <script src="/js/Margenes/EditarMargenes.js?v=0.1.2"></script>


}


@using Newtonsoft.Json;
@using System.Globalization
<!-- Content Header (Page header) -->
<section class="content-header">
    <h1>
        Margenes
    </h1>
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="#"><i class="ti-dashboard"></i></a></li>
        <li class="breadcrumb-item active">Margenes</li>
    </ol>
</section>

<section class="content ">
    <div class="row">
        <div class="col-12">
            <input hidden asp-for="ListaX.idListaPrecio" id="idListaPrecio" />
            <input hidden asp-for="ListaX.idCategoria" id="idCategoria" />
            <input hidden asp-for="ListaX.Moneda" id="idMoneda" />
            <input hidden id="Margenes" value="@JsonConvert.SerializeObject(Model.ListaX)" />
            <input hidden id="Productos" value="@JsonConvert.SerializeObject(Model.Productos)" />

            <input hidden id="PrecioXLista" value="@JsonConvert.SerializeObject(Model.Lista)" />
            <input hidden id="ListaPrecios" value="@JsonConvert.SerializeObject(Model.Precios)" />
            <input hidden id="Categorias" value="@JsonConvert.SerializeObject(Model.Categoria)" />
            <input hidden id="TipoCambio" value="@JsonConvert.SerializeObject(Model.TP)" />

            <input hidden id="urlGenerar" value="@Url.Page("Editar", "AgregarMargen")" />
            <input hidden id="urlProductos" value="@Url.Page("Editar", "Productos")" />




            <!-- Content Header (Page header) -->
            <div class="box">
                <div class="box-header with-border">
                    <div class="row">
                        <div class="col-8">
                            <h6 class="box-subtitle">Margenes</h6>


                        </div>
                        <div class="col-4">
                            <a asp-page="./Index" class="nav-link text-dark" style="text-decoration: underline;"><i class="ti-back-left "></i>  Regresar</a>


                        </div>
                    </div>
                </div>
                <div class="box-body">
                    <!-- title row -->
                    <div class="row">
                        <div class="col-md-3">
                            <div class="page-header mt-0">
                                <h2 class="d-inline"><span class="font-size-24">Margenes</span></h2>
                                <div class="text-left">
                                    <h5>Fecha <span class="font-size-18">@DateTime.Now.ToString("dd MMM yyy")</span></h5>
                                    <input hidden id="Fecha" type="datetime" value="@DateTime.Now" />



                                </div>

                            </div>

                        </div>




                        <!-- /.col -->
                    </div>
                    <!-- info row -->

                    <div class="row invoice-info">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Lista de Precio</label>
                                <select id="ListaSeleccionado" class="form-control select2" onchange="javascript: onChangeListaPrecio()">
                                    <option value="0"> Seleccione Lista de Precio</option>



                                </select>
                            </div>
                        </div>
                        <div class="col-md-2">
                        </div>

                        <div class="col-md-2">
                            <div class="form-group">
                                <h5>Cobertura %<span class="text-danger">*</span></h5>
                                <div class="controls">
                                    <input type="number" id="Cobertura" value="0" class="form-control">
                                </div>

                            </div>

                        </div>

                        <div class="col-md-2">
                            <div class="form-group">
                                <h5>Margen %<span class="text-danger">*</span></h5>
                                <div class="controls">
                                    <input type="number" id="Margen" value="0" class="form-control">
                                </div>

                            </div>

                        </div>

                        <div class="col-md-2">
                            <div class="form-group">
                                <h5>Margen Minimo %<span class="text-danger">*</span></h5>
                                <div class="controls">
                                    <input type="number" id="MargenMin" value="0" class="form-control">
                                </div>

                            </div>

                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Categoria</label>
                                <select id="CategoriaSeleccionado" class="form-control select2" onchange="javascript: onChangeCategoria()">
                                    <option value="0"> Seleccione Categoria</option>



                                </select>
                            </div>
                        </div>
                        <div class="col-md-8">


                            <button type="button" id="botonG" class="btn btn-info pull-right" onclick="    javascript: Setear()">
                                Setear
                            </button>


                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Moneda</label>
                                <select class="form-control" id="MonedaSeleccionado" onchange="javascript: onChangeMoneda()">
                                    <option value="CRC" selected>CRC</option>
                                    <option value="USD">USD</option>

                                </select>
                            </div>
                        </div>
                        <div class="col-12">
                            @*<button id="print" class="btn btn-warning" type="button"> <span><i class="fa fa-print"></i> Imprimir</span> </button>*@
                            <button type="button" id="botonG" class="btn btn-success pull-right" onclick="    javascript: Generar()">
                                <i class="fa fa-credit-card"></i> Generar
                            </button>

                        </div>






                    </div>
                    <!-- /.col -->
                    <!-- /.row -->

                </div>

            </div>





            <div class="box">
                <div class="box-body">
                    <!-- Table row -->
                    <div class="row">
                        <div class="col-md-12  ">
                            <div class="x_panel">
                                <div class="x_content">



                                    <div class="row">
                                        <div class="col-md-9">
                                            <h3>Productos</h3>
                                        </div>


                                    </div>

                                    <div class="row invoice-info">
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label for="busqueda">Buscador:</label>
                                                <input type="text" class="form-control" id="busqueda" placeholder="Ingrese la descripción" oninput="filtrarTabla()">
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                        </div>

                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <h5>Cobertura %<span class="text-danger">*</span></h5>
                                                <div class="controls">
                                                    <input type="number" id="CoberturaT" value="0" class="form-control">
                                                </div>

                                            </div>

                                        </div>

                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <h5>Margen %<span class="text-danger">*</span></h5>
                                                <div class="controls">
                                                    <input type="number" id="MargenT" value="0" class="form-control">
                                                </div>

                                            </div>

                                        </div>

                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <h5>Margen Minimo %<span class="text-danger">*</span></h5>
                                                <div class="controls">
                                                    <input type="number" id="MargenMinT" value="0" class="form-control">
                                                </div>

                                            </div>

                                        </div>
                                        <div class="col-md-4">
                                        </div>
                                        <div class="col-md-8">


                                            <button disabled type="button" id="botonGT" class="btn btn-info pull-right" onclick="    javascript: SetearT()">
                                                Setear
                                            </button>


                                        </div>










                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="box-body">
                            <div class="row">
                                <div class="col-12">

                                    <!-- CONTENEDOR FORZADO -->
                                    <div id="force-scroll-x">
                                        <table class="table table-bordered">
                                            <thead>
                                                <tr>
                                                    <th class="bg-info">No seteable</th>
                                                    <th class="bg-info">Precio Fijo</th>
                                                    <th class="bg-info">Escalonado</th>
                                                    <th class="bg-info">Descripción</th>
                                                    <th class="bg-info">Precio SAP</th>
                                                    <th class="bg-info">Cobertura %</th>
                                                    <th class="bg-info">Precio Cobertura</th>
                                                    <th class="bg-info">Margen Min %</th>
                                                    <th class="bg-info">Precio Min</th>
                                                    <th class="bg-info">Margen %</th>
                                                    <th class="bg-info">Precio Final</th>
                                                    <th class="bg-info">Precio Final Impuesto</th>
                                                    <th class="bg-info">% Ganancia</th>
                                                    <th class="bg-info">Rangos</th>
                                                    <th class="bg-info">Cant Minima</th>
                                                    <th class="bg-info">Cant Maxima</th>
                                                    <th class="bg-info">Margen Min Escalonado</th>
                                                    <th class="bg-info">Precio Escalonado Impuesto</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tbody"></tbody>
                                        </table>
                                    </div>

                                </div>
                            </div>
                        </div>


                        <!-- /.col -->
                    </div>
                    <!-- /.row -->
                    <!-- /.row -->

                </div>
            </div>




        </div>
    </div>

</section>




<!-- Modal -->
<div class="modal fade bs-example-modal-lg" id="ModalInclusion" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="myLargeModalLabel">Observar Factura</h4>
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
            </div>
            <div class="modal-body">

                <div class="text-left">
                    <div class="row">
                        <div class="col-4">
                            <h5> <b>Fecha: </b> <a id="FechaM"> </a></h5>


                        </div>






                        <br />


                        <div class="col-4">
                            <h5> <b>Moneda: </b> <a id="MonedaM"> </a></h5>


                        </div>

                        <div class="col-4">
                            <h5> <b>Cond.Pago: </b> <a id="CondPagoM"> </a></h5>


                        </div>

                        <div class="col-4">
                            <h5> <b>Vendedor: </b>  <a id="VendedorM"> </a></h5>

                        </div>

                        <br />
                        &nbsp;
                        &nbsp;
                        &nbsp;
                        <div class="col-12">
                            <h5> <b>Clave Hacienda: </b><a id="ClaveHacienda"> </a></h5>


                        </div>
                        &nbsp;
                        &nbsp;
                        abr
                        <div class="col-12">
                            <h5> <b>Consecutivo Hacienda: </b> <a id="ConsecutivoHaciendaM"> </a> </h5>



                        </div>



                    </div>
                    <div class="row invoice-info">
                        <div class="col-md-8 invoice-col">
                            <strong>Cliente</strong>
                            <address>
                                <strong id="ClienteM" class="text-blue font-size-24">   </strong>


                            </address>
                        </div>
                        <!-- /.col -->
                    </div>
                    <!-- /.row -->
                    <!-- Table row -->
                    <div class="row">
                        <div class="col-12 table-responsive">
                            <table class="table table-bordered">
                                <thead>
                                    <tr class="bg-pale-info">
                                        <th class="text-center">#</th>
                                        <th class="text-center">Producto</th>
                                        <th class="text-center">Cantidad</th>
                                        <th class="text-center">Precio Unitario</th>
                                        <th class="text-center">% Descuento</th>
                                        <th class="text-center">Descuento</th>
                                        <th class="text-center">Impuesto</th>



                                        <th class="text-center">Total</th>

                                    </tr>
                                </thead>
                                <tbody id="tbodyM">
                                </tbody>
                            </table>
                        </div>
                        <!-- /.col -->
                        <div class="col-12  text-right">


                            <div>
                                <p>Sub Total  : <span id="SubtotalM"> </span></p>
                                <p>Descuento  : <span id="DescuentoM"> </span></p>
                                <p>Impuesto :  <span id="ImpuestoM"> </span></p>

                            </div>
                            <div class="total-payment">
                                <h3><b>Total :</b>  <span id="TotalM">  </span></h3>
                            </div>

                        </div>
                    </div>
                </div>





            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect text-left" data-dismiss="modal">Cerrar</button> &nbsp;


            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<!-- /.modal -->
